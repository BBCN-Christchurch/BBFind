{
  "name": "bbfind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,supavisor,realtime,postgres-meta",
    "db:reset": "supabase db reset",
    "test:backend": "node scripts/test-backend.mjs",
    "test:sql": "bash scripts/test-sql.sh",
    "test:integration": "node scripts/test-local-stack.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"supabase/functions/**/*.{ts,json}\" \"scripts/*.mjs\" \"tests/**/*.{ts,mjs,yml}\" \"*.json\" \"*.ts\" \".github/workflows/*.yml\"",
    "setup:check": "node --use-env-proxy --env-file-if-exists=.env scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.80.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-png": "8.0.0",
    "imagescript": "1.3.1",
    "jpeg-js": "0.4.4",
    "jsdom": "^26.0.0",
    "prettier": "3.9.10",
    "typescript": "~5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
